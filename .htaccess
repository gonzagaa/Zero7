# ==============================
# ZERO7 - CONTROLE DE CACHE
# Aplicado somente na pasta /home
# ==============================

# ==============================
# FERRAMENTA NÃO VAI AO AR
# ==============================
# Tudo que é nosso de desenvolvimento responde 404, suba ou não suba. 404 e
# não 403: o 403 confirma que o arquivo existe. O AUDITORIA-CONTEXTO.md, por
# exemplo, é a lista de pontos fracos do site — não pode ser legível.
#
# RedirectMatch é do mod_alias e só exige AllowOverride FileInfo, a mesma
# classe que o Header abaixo já usa no ar. "Require all denied" não foi usado
# de propósito: exige AuthConfig, e se ela não estiver liberada a pasta
# inteira devolve 500.
#
# backend/ é a função da Vercel (API de Conversões do Meta): roda lá, não
# aqui, e o código-fonte não precisa ficar legível em /home/.
#
# NÃO bloqueie aqui: vendor/, assets/, css/, script/ nem nada que o site
# carrega. "scripts/" (com s, o harness) é diferente de "script/" (o JS do site).
<IfModule mod_alias.c>
  RedirectMatch 404 (?i)\.md$
  RedirectMatch 404 (?i)/comparacao[^/]*\.html?$
  RedirectMatch 404 (?i)/(medidas|scripts|shots|node_modules|\.vscode|\.git|backend)(/|$)
  RedirectMatch 404 (?i)/package(-lock)?\.json$
  RedirectMatch 404 (?i)/dist/manifest\.json$
  RedirectMatch 404 (?i)/\.(gitignore|env)(\.[^/]*)?$
</IfModule>

<IfModule mod_headers.c>

  # HTML: 5 minutos com revalidacao (SEO-06, fase 18). O no-store anterior
  # obrigava a baixar a pagina inteira a cada visita, inclusive no F5.
  <FilesMatch "\.html?$">
    Header always set Cache-Control "max-age=300, must-revalidate"
    Header always unset Pragma
    Header always unset Expires
  </FilesMatch>

  # JSON de planos/preços sempre atualizado
  <FilesMatch "\.(json)$">
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </FilesMatch>

  # CSS e JS podem cachear: os de dist/ trazem hash de conteúdo no NOME
  # (home.<hash8>.css, script/<nome>.<hash8>.js — mudou o conteúdo, muda a
  # URL), e os demais usam ?v=. O RedirectMatch 404 lá de cima NÃO alcança
  # dist/ (conferido: a lista é medidas|scripts|shots|node_modules|.vscode|
  # .git|backend). O dist/manifest.json responde 404 pelo RedirectMatch lá
  # de cima: é mapa do build, não precisa ficar legível no ar.
  <FilesMatch "\.(css|js)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Imagens, fontes, vídeos e assets estáticos. webm/mp4 entraram com a
  # tarja em vídeo (out/2026) — o harness já servia vídeo como immutable
  # (regra 19: ele espelha a produção; agora a produção espelha ele).
  # Consequência: vídeo, como imagem, troca SEMPRE de nome (nome por
  # campanha — scripts/tarja-video.mjs).
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|avif|svg|ico|woff|woff2|ttf|otf|webm|mp4)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

</IfModule>

# Tipos de vídeo: Apache antigo não traz o .webm no mime.types, e vídeo com
# Content-Type errado não toca. Range (206) é nativo do Apache para arquivo
# estático — o <video> pede faixas.
<IfModule mod_mime.c>
  AddType video/webm .webm
  AddType video/mp4 .mp4
</IfModule>

# ETag por data e tamanho: deixa a revalidacao do HTML barata (304).
FileETag MTime Size
